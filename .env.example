# Understory runs without any environment variables.
#
# Optional, only for the Signal news pipeline (scripts/news). Without a key the pipeline
# falls back to extractive summaries.
# ANTHROPIC_API_KEY=
# SIGNAL_MODEL=claude-sonnet-5

# The public origin, used for the sitemap and Open Graph URLs.
# NEXT_PUBLIC_SITE_URL=https://understory.example

# Optional, for the online-test simulator's assistant (docs/ONLINE-TEST.md, section 6).
# On a serverless host such as Vercel, connecting Claude through MCP needs a shared store:
# a free Upstash Redis database, or Vercel's Redis integration (which sets KV_REST_API_*).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Lets `pnpm start` offer "Claude Code on this machine" (always on in `pnpm dev`).
# ASSISTANT_LOCAL_CLI=1

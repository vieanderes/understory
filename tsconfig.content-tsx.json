{
  // React challenges (language: tsx) are checked here: the DOM library and JSX, which the
  // plain content config leaves out on purpose. A tests.tsx imports from
  // '@testing-library/react' and '@testing-library/user-event', typed by the real
  // packages; the sandbox runs its own small user-event with the same call shapes.
  // tests/fixtures/react-challenge is the example the unit tests run.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true
  },
  "include": [
    "content/**/*.tsx",
    "content/harness.d.ts",
    "content/react-harness.d.ts",
    "tests/fixtures/react-challenge/*.tsx"
  ]
}

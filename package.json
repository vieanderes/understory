{
  "name": "understory",
  "version": "0.1.0",
  "private": true,
  "description": "Understory: learn, practise and keep up with software engineering. Local-first, evidence-based, web first.",
  "license": "(MIT AND CC-BY-NC-SA-4.0)",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "audit": "pnpm audit --audit-level=low",
    "build": "next build",
    "build:audio": "tsx scripts/build-audio.ts",
    "build:content": "tsx scripts/build-content.ts",
    "build:lectures": "tsx scripts/build-lectures.ts",
    "build:pyodide": "tsx scripts/copy-pyodide.ts",
    "build:sandbox": "tsx scripts/build-sandbox.ts",
    "build:sql": "tsx scripts/build-sql.ts",
    "build:sw": "tsx scripts/build-sw.ts",
    "build:typecheck": "tsx scripts/build-typecheck.ts",
    "check": "pnpm validate:content && pnpm audit && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "content:readability": "tsx scripts/content-readability.ts",
    "dev": "pnpm build:content && pnpm build:pyodide && pnpm build:typecheck && pnpm build:sql && next dev",
    "format": "prettier --write .",
    "lecture:check": "tsx scripts/validate-content.ts --no-gates",
    "lint": "eslint . && prettier --check .",
    "news": "tsx scripts/news/run.ts",
    "online-tests:check": "tsx scripts/check-online-tests.ts",
    "news:backfill": "tsx scripts/news/backfill.ts",
    "postbuild": "pnpm build:sw && pnpm build:lectures",
    "prebuild": "pnpm build:content && pnpm build:pyodide && pnpm build:typecheck && pnpm build:sql",
    "start": "next start",
    "test": "vitest run --project core --project adapters --project ui && vitest run --project processes",
    "test:coverage": "vitest run --coverage --project core --project adapters --project ui && vitest run --project processes",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && pnpm typecheck:content",
    "typecheck:content": "tsc --noEmit -p tsconfig.content.json && tsc --noEmit -p tsconfig.content-tsx.json",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@electric-sql/pglite": "0.5.8",
    "@gsap/react": "^2.1.2",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@replit/codemirror-vim": "^6.4.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "idb": "^8.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "pyodide": "0.27.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.11.1",
    "jsdom": "^30.1.0",
    "linkedom": "0.18.13",
    "marked": "^18.0.13",
    "postcss": "^8.5.28",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understory.dev/schemas/compiled-placement.schema.json",
  "title": "Compiled placement ladder",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "rungs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rung": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "moduleBand": {
            "type": "array",

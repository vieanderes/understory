              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "predict-output"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "concept": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$",
                      "description": "The concept this step gives evidence for."
                    },
                    "difficulty": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5,
                      "description": "Difficulty from 1 (recognise) to 5 (hard)."
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The code the step is about. 15 lines or fewer, complete, in a plain realistic setting."
                    },
                    "language": {
                      "type": "string",
                      "enum": [
                        "js",
                        "ts",
                        "jsx",
                        "tsx",
                        "html",
                        "css",
                        "sql",
                        "json",
                        "bash",
                        "yaml",
                        "http",
                        "python",
                        "text"

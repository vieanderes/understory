                    "question": {
                      "type": "object",
                      "properties": {
                        "md": {
                          "type": "string"
                        },
                        "html": {
                          "type": "string",
                          "description": "HTML rendered at build time. Colours are CSS variables."
                        }
                      },
                      "required": [
                        "md",
                        "html"
                      ],

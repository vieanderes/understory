# dependencies
/node_modules

# next.js build output
/.next/
/.next-*/
/out/

# generated at build time (scripts/build-content.ts, scripts/build-sw.ts, scripts/copy-pyodide.ts,
# scripts/build-typecheck.ts, scripts/build-sql.ts, scripts/build-lectures.ts)
/public/content/
/public/sw.js
/public/pyodide/
/public/typescript/
/public/sql/
/public/pdf/
/public/audio/
/.cache/

# tests
/coverage
/test-results/
/playwright-report/

# env files: never commit secrets. Copy .env.example to .env.local for local overrides.
.env*
!.env.example

# OS / editor
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# logs
npm-debug.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# swift
/ios/**/.build/
/ios/**/.swiftpm/

# The mascot kit as delivered. Everything it holds is copied into the repo.
/mascot/

# Temporary git worktrees made by coding agents
.claude/worktrees/
.vercel

{
  "name": "interview-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Practice katas and build briefs for senior full-stack and AI engineering interviews.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "kata": "tsx scripts/kata.ts",
    "timer": "tsx scripts/timer.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:rag": "tsx katas/rag-mini/eval/run-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understory.dev/schemas/manifest.schema.json",
  "title": "Bundle manifest",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "contentRev": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "course": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary"
      ],
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "number": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "One sentence on why this chapter matters."
          },
          "youCanBuild": {
            "type": "string",
            "minLength": 1,
            "description": "What the learner can build after the chapter."
          },
          "lab": {
            "type": "string"
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The concept name, as the spec names it."
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One sentence."
                },
                "confusableWith": {
                  "description": "Concepts learners mix up with this one. Practice interleaves them.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
                  }
                }
              },
              "required": [
                "id",
                "title",
                "summary"
              ],
              "additionalProperties": false
            }
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
                },
                "slug": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "objective": {
                  "type": "string"
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "essential",
                    "advanced"
                  ]
                },
                "minutes": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "concepts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
                  }
                },
                "prerequisites": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
                  }
                },
                "stepCount": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "stepTypes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "prose",
                      "predict-output",
                      "multiple-choice",
                      "trace-table",
                      "fill-blank",
                      "parsons",
                      "bug-hunt",
                      "ai-review",
                      "code-challenge",
                      "explain-back",
                      "lab",
                      "incident",
                      "playground",
                      "sql"
                    ]
                  }
                },
                "needsTyping": {
                  "type": "boolean"
                },
                "assessment": {
                  "type": "boolean",
                  "const": true
                },
                "file": {
                  "type": "string"
                },
                "solutionsFile": {
                  "type": "string"
                },
                "lectureFile": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "slug",
                "title",
                "objective",
                "level",
                "minutes",
                "concepts",
                "prerequisites",
                "stepCount",
                "stepTypes",
                "needsTyping",
                "file",
                "lectureFile"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "number",
          "slug",
          "title",
          "summary",
          "why",
          "youCanBuild",
          "concepts",
          "lessons"
        ],
        "additionalProperties": false
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$",
            "description": "One lowercase word that is not a module id, for example \"firstcode\"."
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*$"
            }
          },
          "capstone": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "brief": {
                "type": "string"
              },
              "solutionFile": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "brief"
            ],
            "additionalProperties": false
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
            }
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "modules",
          "capstone",
          "lessons",
          "concepts"
        ],
        "additionalProperties": false
      }
    },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "file"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "contentRev",
    "course",
    "modules",
    "parts",
    "guides"
  ],
  "additionalProperties": false
}

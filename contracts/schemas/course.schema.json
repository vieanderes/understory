{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understory.dev/schemas/course.schema.json",
  "title": "Course (course.yaml)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The course title."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentences."
    },
    "parts": {
      "description": "The course in parts, in course order. Every module that is not woven is in one.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$",
            "description": "One lowercase word that is not a module id, for example \"firstcode\"."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "The part title."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "One sentence: what the learner can do after this part."
          },
          "modules": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*$"
            },
            "description": "Module ids, in course order. Woven modules belong to no part."
          },
          "capstone": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "The project, as a noun phrase."
              },
              "brief": {
                "type": "string",
                "minLength": 1,
                "description": "What to build, in a short paragraph of plain text. It draws on the modules of the part."
              }
            },
            "required": [
              "title",
              "brief"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "modules",
          "capstone"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "summary"
  ],
  "additionalProperties": false
}

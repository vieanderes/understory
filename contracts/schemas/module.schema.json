{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understory.dev/schemas/module.schema.json",
  "title": "Module (module.yaml)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "number": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The module title."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentences."
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence on why this chapter matters."
    },
    "youCanBuild": {
      "type": "string",
      "minLength": 1,
      "description": "What the learner can build after the chapter."
    },
    "lab": {
      "description": "The signature lab of this module.",
      "type": "string"
    },
    "concepts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "The concept name, as the spec names it."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "One sentence."
          },
          "confusableWith": {
            "description": "Concepts learners mix up with this one. Practice interleaves them.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "number",
    "title",
    "summary",
    "why",
    "youCanBuild",
    "concepts"
  ],
  "additionalProperties": false
}

                              "html"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "text",
                          "feedback"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "codeHtml": {
                      "type": "string",
                      "description": "HTML rendered at build time. Colours are CSS variables."
